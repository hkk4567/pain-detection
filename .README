    --cropped_expr_dir "dataset_osfstorage-archive/Stimuli/Expression Images/Cropped and Standardized" `
    --unedited_only_dir "dataset_osfstorage-archive/Stimuli/Neutral Only Images/Unedited_Only_FaceCrops" `
    --cropped_only_dir "dataset_osfstorage-archive/Stimuli/Neutral Only Images/Cropped and Standardized"

python generate_report.py `
    --input_dir "error_analysis" `
    --output_dir "reports" `
    --unedited_expr_dir "dataset_osfstorage-archive/Stimuli/Expression Images/Unedited_FaceCrops" `
    --cropped_expr_dir "dataset_osfstorage-archive/Stimuli/Expression Images/Cropped and Standardized" `
    --unedited_only_dir "dataset_osfstorage-archive/Stimuli/Neutral Only Images/Unedited_Only_FaceCrops" `
    --cropped_only_dir "dataset_osfstorage-archive/Stimuli/Neutral Only Images/Cropped and Standardized"

